# Example configuration exported from a working VM with scripts/export-vmx.py.
# Machine-specific values (UUIDs, generated MACs, runtime state) were removed;
# VMware Workstation regenerates them when the VM is registered and powered on.
.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "22"
displayName = "truenas-25.10-storage"
annotation = "TrueNAS Community Edition 25.10 - shared storage (ZFS mirror, NFS).|0AWeb UI https://10.10.8.13 (nat), storage on lab 10.10.10.13.|0ABuilt 2026-11-07."
guestOS = "debian12-64"
firmware = "efi"
uefi.secureBoot.enabled = "FALSE"
numvcpus = "2"
cpuid.coresPerSocket = "2"
memsize = "8192"
nvram = "truenas-25.10-storage.nvram"
uuid.action = "keep"
pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"
pciBridge6.present = "TRUE"
pciBridge6.virtualDev = "pcieRootPort"
pciBridge6.functions = "8"
pciBridge7.present = "TRUE"
pciBridge7.virtualDev = "pcieRootPort"
pciBridge7.functions = "8"
vmci0.present = "TRUE"
nvme0.present = "TRUE"
nvme0.pciSlotNumber = "224"
nvme0:0.present = "TRUE"
nvme0:0.fileName = "truenas-25.10-storage.vmdk"
nvme0:1.present = "TRUE"
nvme0:1.fileName = "truenas-25.10-storage-data1.vmdk"
nvme0:2.present = "TRUE"
nvme0:2.fileName = "truenas-25.10-storage-data2.vmdk"
sata0.present = "TRUE"
sata0:1.present = "TRUE"
ethernet0.present = "TRUE"
ethernet0.virtualDev = "vmxnet3"
ethernet0.pciSlotNumber = "160"
ethernet0.connectionType = "nat"
ethernet0.addressType = "generated"
ethernet0.startConnected = "TRUE"
ethernet1.present = "TRUE"
ethernet1.virtualDev = "vmxnet3"
ethernet1.pciSlotNumber = "192"
ethernet1.connectionType = "custom"
ethernet1.vnet = "vmnet10"
ethernet1.addressType = "generated"
ethernet1.startConnected = "TRUE"
floppy0.present = "FALSE"
sound.present = "FALSE"
usb.present = "FALSE"
mks.enable3d = "FALSE"
svga.present = "TRUE"
tools.syncTime = "FALSE"
tools.upgrade.policy = "manual"
virtualHW.productCompatibility = "hosted"
sata0:1.deviceType = "cdrom-raw"
sata0:1.fileName = "auto detect"
sata0:1.startConnected = "FALSE"
sata0:1.autodetect = "TRUE"
